@startuml

title Diagrama de secuencia - Crear reserva de turno

actor Usuario as u
participant Web as w
participant "API de turnos" as apit
database "BD de turnos" as dbt

autoactivate on

u -> w: Crear reserva de turno
w -> apit: (interacción inicia, JWT ya disponible en el front)
apit -> apit: verificarJWT({jwt})
apit --> apit: {usuario_id, rol} / error

alt JWT válido

  u -> w: Seleccionar servicio
  w -> apit: GET /servicios
  apit -> dbt: Consultar servicios disponibles
  dbt --> apit: Lista de servicios
  apit --> w: HTTP 200 {servicios}
  w --> u: Mostrar servicios

  u -> w: Seleccionar servicio
  w -> apit: GET /profesionales?servicio={idServicio}
  apit -> dbt: Consultar profesionales asociados al servicio
  dbt --> apit: Profesionales disponibles
  apit --> w: HTTP 200 {profesionales}
  w --> u: Mostrar profesionales

  u -> w: Seleccionar profesional
  u -> w: Seleccionar fecha
  w -> apit: GET /disponibilidad {servicio, profesional, fecha}
  apit -> dbt: Consultar disponibilidad profesional + servicio + fecha
  dbt --> apit: Horarios disponibles
  apit --> w: HTTP 200 {horarios}
  w --> u: Mostrar horarios disponibles

  u -> w: Seleccionar horario
  w -> apit: POST /reservas {servicio, profesional, fecha, horario}
  apit -> apit: Validar datos de la reserva

  alt Datos con formato incorrecto
    apit --> w: HTTP 400 Bad Request {error}
  else Datos correctos

    apit -> dbt: Validar servicio
    dbt --> apit: Servicio válido / error

    apit -> dbt: GET /profesionales/{id}/servicios/{idServicio}
    dbt -> dbt: Verificar relación Profesional-Servicio
    dbt --> apit: Relación válida / error

    apit -> dbt: Validar fecha y horario
    dbt --> apit: Disponible / no disponible

    alt Reserva válida y disponible
      apit -> dbt: UPDATE disponibilidad SET ocupado=true WHERE id={disponibilidad_id}
      dbt --> apit: OK
      apit -> dbt: INSERT INTO turno (usuario_id, profesional_servicio_id, disponibilidad_id, fecha_hora, estado) \nVALUES ({usuario_id}, ..., 'pendiente')
      dbt --> apit: {reserva}
      apit --> w: HTTP 201 Created {reserva}
      w --> u: Mostrar confirmación de turno
    else Error de negocio
      apit --> w: HTTP 422 Unprocessable Entity {error}
    end

  end

else JWT inválido
  apit --> w: HTTP 401 Unauthorized {error}
end

@enduml